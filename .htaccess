RewriteEngine On
RewriteBase /Express/

# Block all hidden files (starting with dot, e.g. .env, .git, .htaccess)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct access to config and sql files
<FilesMatch "(^config\.php|\.env|\.sql|\.json|\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block .git access first (must be before other rules)
RewriteRule ^\.git - [F,L]

# If the requested file or directory exists, serve it directly (e.g. assets, svg)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, redirect everything cleanly through index.php
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]

